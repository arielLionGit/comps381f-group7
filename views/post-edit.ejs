<%- include('partials/header') %>

<div class="container">
  <div style="max-width: 900px; margin: 3rem auto;">
    <div class="card">
      <div class="card-header">
        <h2>Edit Post</h2>
      </div>
      <div class="card-body">
        <% if (errors && errors.length > 0) { %>
          <div class="form-error">
            <ul>
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/post/<%= post._id %>/edit" method="POST" enctype="multipart/form-data">
          <div class="form-group">
            <label for="title" class="form-label">Title *</label>
            <input type="text" id="title" name="title" class="form-control" value="<%= post.title %>" required maxlength="200">
          </div>

          <div class="form-group">
            <label for="content" class="form-label">Content *</label>
            <textarea id="content" name="content" class="form-control" required><%= post.content %></textarea>
          </div>

          <% if (post.images && post.images.length > 0) { %>
            <div class="form-group">
              <label class="form-label">Existing Images</label>
              <div class="post-images">
                <% post.images.forEach((image, index) => { %>
                  <div style="position: relative;">
                    <img src="<%= image.data || image.path %>" alt="<%= image.filename || 'Post image' %>" class="post-image">
                    <label style="position: absolute; top: 10px; right: 10px; background: white; padding: 5px; border-radius: 5px;">
                      <input type="checkbox" name="removeImages" value="<%= index %>">
                      Remove
                    </label>
                  </div>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="form-group">
            <label for="images" class="form-label">Add Images (max 5)</label>
            <input type="file" id="images" name="images" class="form-control" multiple accept="image/*">
            <small style="color: var(--text-light);">Supported: JPEG, JPG, PNG, GIF, WebP. Max 5MB each.</small>
          </div>

          <div class="form-group">
            <label for="tags" class="form-label">Tags</label>
            <input type="text" id="tags" name="tags" class="form-control" value="<%= post.tags ? post.tags.join(', ') : '' %>" placeholder="e.g. tech,life,travel (comma-separated)">
          </div>

          <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary">Update Post</button>
            <a href="/post/<%= post._id %>" class="btn btn-outline">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
