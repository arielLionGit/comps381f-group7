<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Blog Platform</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container navbar-content">
      <a href="/" class="navbar-brand">📝 Blog Platform</a>
      <ul class="navbar-menu">
        <li><a href="/">Home</a></li>
        <li><a href="/search">Search</a></li>
        <% if (user) { %>
          <li><a href="/create">Create Post</a></li>
          <% if (isAdmin) { %>
            <li><a href="/admin/dashboard">Admin Dashboard</a></li>
          <% } %>
          <li class="navbar-user">
            <span class="navbar-username">👤 <%= user %></span>
            <a href="/logout" class="btn btn-sm btn-outline">Logout</a>
          </li>
        <% } else { %>
          <li><a href="/login" class="btn btn-sm btn-primary">Login</a></li>
          <li><a href="/register" class="btn btn-sm btn-secondary">Register</a></li>
        <% } %>
      </ul>
    </div>
  </nav>
