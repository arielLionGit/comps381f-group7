<%- include('../partials/header') %>

<div class="container admin-dashboard">
  <h1 style="margin-bottom: 2rem;">文章管理</h1>

  <div class="card">
    <div class="card-body">
      <table class="table">
        <thead>
          <tr>
            <th>標題</th>
            <th>作者</th>
            <th>發表時間</th>
            <th>瀏覽次數</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% posts.forEach(post => { %>
            <tr>
              <td><a href="/post/<%= post._id %>"><%= post.title %></a></td>
              <td><%= post.authorName %></td>
              <td><%= new Date(post.createdAt).toLocaleString('zh-TW') %></td>
              <td><%= post.viewCount %></td>
              <td>
                <a href="/post/<%= post._id %>/edit" class="btn btn-sm btn-secondary">編輯</a>
                <form action="/post/<%= post._id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('確定要刪除這篇文章嗎？');">
                  <button type="submit" class="btn btn-sm btn-danger">刪除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 分頁 -->
  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/admin/posts?page=<%= currentPage - 1 %>">上一頁</a>
      <% } %>
      
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
          <span class="active"><%= i %></span>
        <% } else { %>
          <a href="/admin/posts?page=<%= i %>"><%= i %></a>
        <% } %>
      <% } %>
      
      <% if (currentPage < totalPages) { %>
        <a href="/admin/posts?page=<%= currentPage + 1 %>">下一頁</a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
