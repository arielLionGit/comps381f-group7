<%- include('../partials/header') %>

<div class="container admin-dashboard">
  <h1 style="margin-bottom: 2rem;">留言管理</h1>

  <div class="card">
    <div class="card-body">
      <table class="table">
        <thead>
          <tr>
            <th>內容</th>
            <th>作者</th>
            <th>文章</th>
            <th>時間</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% comments.forEach(comment => { %>
            <tr>
              <td><%= comment.content.substring(0, 100) %><%= comment.content.length > 100 ? '...' : '' %></td>
              <td><%= comment.authorName %></td>
              <td><a href="/post/<%= comment.post._id %>"><%= comment.post.title %></a></td>
              <td><%= new Date(comment.createdAt).toLocaleString('zh-TW') %></td>
              <td>
                <form action="/comment/<%= comment._id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('確定要刪除這則留言嗎？');">
                  <button type="submit" class="btn btn-sm btn-danger">刪除</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 分頁 -->
  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/admin/comments?page=<%= currentPage - 1 %>">上一頁</a>
      <% } %>
      
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
          <span class="active"><%= i %></span>
        <% } else { %>
          <a href="/admin/comments?page=<%= i %>"><%= i %></a>
        <% } %>
      <% } %>
      
      <% if (currentPage < totalPages) { %>
        <a href="/admin/comments?page=<%= currentPage + 1 %>">下一頁</a>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
