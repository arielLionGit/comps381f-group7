<%- include('../partials/header') %>

<div class="container admin-dashboard">
  <h1 style="margin-bottom: 2rem;">Admin Dashboard</h1>

  <!-- Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-title">Total Users</div>
      <div class="stat-value"><%= stats.totalUsers %></div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Total Posts</div>
      <div class="stat-value"><%= stats.totalPosts %></div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Total Comments</div>
      <div class="stat-value"><%= stats.totalComments %></div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Banned Users</div>
      <div class="stat-value" style="color: var(--danger-color);"><%= stats.bannedUsers %></div>
    </div>
  </div>

  <!-- Quick links -->
  <div class="card mb-3">
    <div class="card-header">Management Tools</div>
    <div class="card-body">
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a href="/admin/users" class="btn btn-primary">Users</a>
        <a href="/admin/posts" class="btn btn-primary">Posts</a>
        <a href="/admin/comments" class="btn btn-primary">Comments</a>
      </div>
    </div>
  </div>

  <!-- Recently registered users -->
  <div class="card mb-3">
    <div class="card-header">Recently Registered Users</div>
    <div class="card-body">
      <table class="table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Registered At</th>
            <th>Logins</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% recentUsers.forEach(user => { %>
            <tr>
              <td><a href="/admin/users/<%= user._id %>"><%= user.username %></a></td>
              <td><%= user.email %></td>
              <td><%= new Date(user.createdAt).toLocaleDateString('en-US') %></td>
              <td><%= user.loginCount %></td>
              <td>
                <% if (user.isBanned) { %>
                  <span style="color: var(--danger-color);">Banned</span>
                <% } else { %>
                  <span style="color: var(--success-color);">Active</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Most active users -->
  <div class="card mb-3">
    <div class="card-header">Most Active Users</div>
    <div class="card-body">
      <table class="table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Login Count</th>
            <th>Last Login</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% activeUsers.forEach(user => { %>
            <tr>
              <td><a href="/admin/users/<%= user._id %>"><%= user.username %></a></td>
              <td><%= user.loginCount %></td>
              <td><%= user.lastLogin ? new Date(user.lastLogin).toLocaleString('en-US') : 'Never' %></td>
              <td>
                <% if (user.isBanned) { %>
                  <span style="color: var(--danger-color);">Banned</span>
                <% } else { %>
                  <span style="color: var(--success-color);">Active</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent posts -->
  <div class="card">
    <div class="card-header">Recent Posts</div>
    <div class="card-body">
      <table class="table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Author</th>
            <th>Published At</th>
            <th>Views</th>
          </tr>
        </thead>
        <tbody>
          <% recentPosts.forEach(post => { %>
            <tr>
              <td><a href="/post/<%= post._id %>"><%= post.title %></a></td>
              <td><%= post.authorName %></td>
              <td><%= new Date(post.createdAt).toLocaleString('en-US') %></td>
              <td><%= post.viewCount %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
