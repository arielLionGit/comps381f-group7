<%- include('../partials/header') %>

<div class="container admin-dashboard">
  <h1 style="margin-bottom: 2rem;">用戶管理</h1>

  <div class="card">
    <div class="card-body">
      <table class="table">
        <thead>
          <tr>
            <th>用戶名</th>
            <th>電子郵件</th>
            <th>註冊時間</th>
            <th>登入次數</th>
            <th>最後登入</th>
            <th>狀態</th>
            <th>操作</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td><a href="/admin/users/<%= user._id %>"><%= user.username %></a></td>
              <td><%= user.email %></td>
              <td><%= new Date(user.createdAt).toLocaleDateString('zh-TW') %></td>
              <td><%= user.loginCount %></td>
              <td><%= user.lastLogin ? new Date(user.lastLogin).toLocaleString('zh-TW') : '從未登入' %></td>
              <td>
                <% if (user.isBanned) { %>
                  <span style="color: var(--danger-color);">已禁止</span>
                <% } else { %>
                  <span style="color: var(--success-color);">正常</span>
                <% } %>
              </td>
              <td>
                <% if (user.isBanned) { %>
                  <button onclick="unbanUser('<%= user._id %>')" class="btn btn-sm btn-success">解除禁止</button>
                <% } else { %>
                  <button onclick="banUser('<%= user._id %>')" class="btn btn-sm btn-danger">禁止</button>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 分頁 -->
  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/admin/users?page=<%= currentPage - 1 %>">上一頁</a>
      <% } %>
      
      <% for (let i = 1; i <= totalPages; i++) { %>
        <% if (i === currentPage) { %>
          <span class="active"><%= i %></span>
        <% } else { %>
          <a href="/admin/users?page=<%= i %>"><%= i %></a>
        <% } %>
      <% } %>
      
      <% if (currentPage < totalPages) { %>
        <a href="/admin/users?page=<%= currentPage + 1 %>">下一頁</a>
      <% } %>
    </div>
  <% } %>
</div>

<script>
async function banUser(userId) {
  if (!confirm('確定要禁止此用戶嗎？')) return;
  
  try {
    const response = await fetch(`/admin/users/${userId}/ban`, {
      method: 'POST'
    });
    const data = await response.json();
    
    if (data.success) {
      alert(data.message);
      location.reload();
    } else {
      alert('操作失敗：' + data.message);
    }
  } catch (error) {
    alert('操作失敗，請稍後再試');
  }
}

async function unbanUser(userId) {
  if (!confirm('確定要解除禁止此用戶嗎？')) return;
  
  try {
    const response = await fetch(`/admin/users/${userId}/unban`, {
      method: 'POST'
    });
    const data = await response.json();
    
    if (data.success) {
      alert(data.message);
      location.reload();
    } else {
      alert('操作失敗：' + data.message);
    }
  } catch (error) {
    alert('操作失敗，請稍後再試');
  }
}
</script>

<%- include('../partials/footer') %>
