<%- include('../partials/header') %>

<div class="container admin-dashboard">
  <h1 style="margin-bottom: 2rem;">用戶詳情</h1>

  <div class="card mb-3">
    <div class="card-header">基本資訊</div>
    <div class="card-body">
      <table class="table">
        <tr>
          <th style="width: 200px;">用戶名</th>
          <td><%= targetUser.username %></td>
        </tr>
        <tr>
          <th>電子郵件</th>
          <td><%= targetUser.email %></td>
        </tr>
        <tr>
          <th>註冊時間</th>
          <td><%= new Date(targetUser.createdAt).toLocaleString('zh-TW') %></td>
        </tr>
        <tr>
          <th>登入次數</th>
          <td><%= targetUser.loginCount %></td>
        </tr>
        <tr>
          <th>最後登入</th>
          <td><%= targetUser.lastLogin ? new Date(targetUser.lastLogin).toLocaleString('zh-TW') : '從未登入' %></td>
        </tr>
        <tr>
          <th>狀態</th>
          <td>
            <% if (targetUser.isBanned) { %>
              <span style="color: var(--danger-color);">已禁止</span>
            <% } else { %>
              <span style="color: var(--success-color);">正常</span>
            <% } %>
          </td>
        </tr>
      </table>
      
      <div style="margin-top: 1rem;">
        <% if (targetUser.isBanned) { %>
          <button onclick="unbanUser('<%= targetUser._id %>')" class="btn btn-success">解除禁止</button>
        <% } else { %>
          <button onclick="banUser('<%= targetUser._id %>')" class="btn btn-danger">禁止用戶</button>
        <% } %>
        <a href="/admin/users" class="btn btn-outline">返回列表</a>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">最近發表的文章</div>
    <div class="card-body">
      <% if (posts.length > 0) { %>
        <table class="table">
          <thead>
            <tr>
              <th>標題</th>
              <th>發表時間</th>
              <th>瀏覽次數</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
              <tr>
                <td><a href="/post/<%= post._id %>"><%= post.title %></a></td>
                <td><%= new Date(post.createdAt).toLocaleString('zh-TW') %></td>
                <td><%= post.viewCount %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: var(--text-light);">此用戶還沒有發表任何文章</p>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">最近的留言</div>
    <div class="card-body">
      <% if (comments.length > 0) { %>
        <table class="table">
          <thead>
            <tr>
              <th>內容</th>
              <th>文章</th>
              <th>時間</th>
            </tr>
          </thead>
          <tbody>
            <% comments.forEach(comment => { %>
              <tr>
                <td><%= comment.content.substring(0, 50) %><%= comment.content.length > 50 ? '...' : '' %></td>
                <td><a href="/post/<%= comment.post._id %>"><%= comment.post.title %></a></td>
                <td><%= new Date(comment.createdAt).toLocaleString('zh-TW') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: var(--text-light);">此用戶還沒有發表任何留言</p>
      <% } %>
    </div>
  </div>
</div>

<script>
async function banUser(userId) {
  if (!confirm('確定要禁止此用戶嗎？')) return;
  
  try {
    const response = await fetch(`/admin/users/${userId}/ban`, {
      method: 'POST'
    });
    const data = await response.json();
    
    if (data.success) {
      alert(data.message);
      location.reload();
    } else {
      alert('操作失敗：' + data.message);
    }
  } catch (error) {
    alert('操作失敗，請稍後再試');
  }
}

async function unbanUser(userId) {
  if (!confirm('確定要解除禁止此用戶嗎？')) return;
  
  try {
    const response = await fetch(`/admin/users/${userId}/unban`, {
      method: 'POST'
    });
    const data = await response.json();
    
    if (data.success) {
      alert(data.message);
      location.reload();
    } else {
      alert('操作失敗：' + data.message);
    }
  } catch (error) {
    alert('操作失敗，請稍後再試');
  }
}
</script>

<%- include('../partials/footer') %>
