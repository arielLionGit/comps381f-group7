<%- include('../partials/header') %>

<div class="container admin-dashboard">
  <h1 style="margin-bottom: 2rem;">User Details</h1>

  <div class="card mb-3">
    <div class="card-header">Basic Info</div>
    <div class="card-body">
      <table class="table">
        <tr>
          <th style="width: 200px;">Username</th>
          <td><%= targetUser.username %></td>
        </tr>
        <tr>
          <th>Email</th>
          <td><%= targetUser.email %></td>
        </tr>
        <tr>
          <th>Registered At</th>
          <td><%= new Date(targetUser.createdAt).toLocaleString('zh-HK', { timeZone: 'Asia/Hong_Kong' }) %></td>
        </tr>
        <tr>
          <th>Login Count</th>
          <td><%= targetUser.loginCount %></td>
        </tr>
        <tr>
          <th>Last Login</th>
          <td><%= targetUser.lastLogin ? new Date(targetUser.lastLogin).toLocaleString('zh-HK', { timeZone: 'Asia/Hong_Kong' }) : 'Never' %></td>
        </tr>
        <tr>
          <th>Status</th>
          <td>
            <% if (targetUser.isBanned) { %>
              <span style="color: var(--danger-color);">Banned</span>
            <% } else { %>
              <span style="color: var(--success-color);">Active</span>
            <% } %>
          </td>
        </tr>
      </table>
      
      <div style="margin-top: 1rem;">
        <% if (targetUser.isBanned) { %>
          <button onclick="unbanUser('<%= targetUser._id %>')" class="btn btn-success">Unban</button>
        <% } else { %>
          <button onclick="banUser('<%= targetUser._id %>')" class="btn btn-danger">Ban User</button>
        <% } %>
        <a href="/admin/users" class="btn btn-outline">Back to list</a>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-header">Recent Posts</div>
    <div class="card-body">
      <% if (posts.length > 0) { %>
        <table class="table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Published At</th>
              <th>Views</th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(post => { %>
              <tr>
                <td><a href="/post/<%= post._id %>"><%= post.title %></a></td>
                <td><%= new Date(post.createdAt).toLocaleString('zh-HK', { timeZone: 'Asia/Hong_Kong' }) %></td>
                <td><%= post.viewCount %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: var(--text-light);">This user hasn't posted anything yet.</p>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">Recent Comments</div>
    <div class="card-body">
      <% if (comments.length > 0) { %>
        <table class="table">
          <thead>
            <tr>
              <th>Content</th>
              <th>Post</th>
              <th>Time</th>
            </tr>
          </thead>
          <tbody>
            <% comments.forEach(comment => { %>
              <tr>
                <td><%= comment.content.substring(0, 50) %><%= comment.content.length > 50 ? '...' : '' %></td>
                <td><a href="/post/<%= comment.post._id %>"><%= comment.post.title %></a></td>
                <td><%= new Date(comment.createdAt).toLocaleString('zh-HK', { timeZone: 'Asia/Hong_Kong' }) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p style="color: var(--text-light);">This user hasn't left any comments.</p>
      <% } %>
    </div>
  </div>
</div>

<script>
async function banUser(userId) {
  if (!confirm('Are you sure you want to ban this user?')) return;
  
  try {
    const response = await fetch(`/admin/users/${userId}/ban`, {
      method: 'POST'
    });
    const data = await response.json();
    
    if (data.success) {
      alert(data.message);
      location.reload();
    } else {
      alert('Action failed: ' + data.message);
    }
  } catch (error) {
    alert('Action failed, please try again later.');
  }
}

async function unbanUser(userId) {
  if (!confirm('Unban this user?')) return;
  
  try {
    const response = await fetch(`/admin/users/${userId}/unban`, {
      method: 'POST'
    });
    const data = await response.json();
    
    if (data.success) {
      alert(data.message);
      location.reload();
    } else {
      alert('Action failed: ' + data.message);
    }
  } catch (error) {
    alert('Action failed, please try again later.');
  }
}
</script>

<%- include('../partials/footer') %>
