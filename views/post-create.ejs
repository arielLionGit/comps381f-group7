<%- include('partials/header') %>

<div class="container">
  <div style="max-width: 900px; margin: 3rem auto;">
    <div class="card">
      <div class="card-header">
        <h2>Create New Post</h2>
      </div>
      <div class="card-body">
        <% if (errors && errors.length > 0) { %>
          <div class="form-error">
            <ul>
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/create" method="POST" enctype="multipart/form-data">
          <div class="form-group">
            <label for="title" class="form-label">Title *</label>
            <input type="text" id="title" name="title" class="form-control" required maxlength="200">
          </div>

          <div class="form-group">
            <label for="content" class="form-label">Content *</label>
            <textarea id="content" name="content" class="form-control" required></textarea>
          </div>

          <div class="form-group">
            <label for="images" class="form-label">Upload Images (max 5)</label>
            <input type="file" id="images" name="images" class="form-control" multiple accept="image/*">
            <small style="color: var(--text-light);">Supported: JPEG, JPG, PNG, GIF, WebP. Max 5MB per image.</small>
          </div>

          <div class="form-group">
            <label for="tags" class="form-label">Tags</label>
            <input type="text" id="tags" name="tags" class="form-control" placeholder="e.g. tech,life,travel (comma-separated)">
          </div>

          <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary">Publish</button>
            <a href="/" class="btn btn-outline">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
