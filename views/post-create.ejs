<%- include('partials/header') %>

<div class="container">
  <div style="max-width: 900px; margin: 3rem auto;">
    <div class="card">
      <div class="card-header">
        <h2>發表新文章</h2>
      </div>
      <div class="card-body">
        <% if (errors && errors.length > 0) { %>
          <div class="form-error">
            <ul>
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/create" method="POST" enctype="multipart/form-data">
          <div class="form-group">
            <label for="title" class="form-label">標題 *</label>
            <input type="text" id="title" name="title" class="form-control" required maxlength="200">
          </div>

          <div class="form-group">
            <label for="content" class="form-label">內容 *</label>
            <textarea id="content" name="content" class="form-control" required></textarea>
          </div>

          <div class="form-group">
            <label for="images" class="form-label">上傳圖片（最多 5 張）</label>
            <input type="file" id="images" name="images" class="form-control" multiple accept="image/*">
            <small style="color: var(--text-light);">支援格式：JPEG, JPG, PNG, GIF, WebP，每張最大 5MB</small>
          </div>

          <div class="form-group">
            <label for="tags" class="form-label">標籤</label>
            <input type="text" id="tags" name="tags" class="form-control" placeholder="例如：技術,生活,旅遊（用逗號分隔）">
          </div>

          <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary">發表文章</button>
            <a href="/" class="btn btn-outline">取消</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
