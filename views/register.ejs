<%- include('partials/header') %>

<div class="container">
  <div style="max-width: 500px; margin: 3rem auto;">
    <div class="card">
      <div class="card-header">
        <h2>註冊</h2>
      </div>
      <div class="card-body">
        <% if (errors && errors.length > 0) { %>
          <div class="form-error">
            <ul>
              <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form action="/register" method="POST">
          <div class="form-group">
            <label for="username" class="form-label">用戶名</label>
            <input type="text" id="username" name="username" class="form-control" required>
            <small style="color: var(--text-light);">3-50 個字元，只能包含字母、數字和底線</small>
          </div>

          <div class="form-group">
            <label for="email" class="form-label">電子郵件</label>
            <input type="email" id="email" name="email" class="form-control" required>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">密碼</label>
            <input type="password" id="password" name="password" class="form-control" required>
            <small style="color: var(--text-light);">至少 6 個字元</small>
          </div>

          <div class="form-group">
            <label for="confirmPassword" class="form-label">確認密碼</label>
            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required>
          </div>

          <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">註冊</button>
        </form>

        <p style="text-align: center; margin-top: 1rem; color: var(--text-light);">
          已有帳號？ <a href="/login" style="color: var(--primary-color);">立即登入</a>
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
