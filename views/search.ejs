<%- include('partials/header') %>

<div class="container">
  <div class="search-form">
    <h1 style="margin-bottom: 1.5rem;">Search Posts</h1>
    
    <form action="/search" method="GET">
      <div class="form-group">
        <label for="q" class="form-label">Keyword</label>
        <input type="text" id="q" name="q" class="form-control" value="<%= searchQuery %>" placeholder="Search title or content...">
      </div>

      <div class="search-filters">
        <div class="form-group">
          <label for="startDate" class="form-label">Start Date</label>
          <input type="date" id="startDate" name="startDate" class="form-control" value="<%= startDate %>">
        </div>

        <div class="form-group">
          <label for="endDate" class="form-label">End Date</label>
          <input type="date" id="endDate" name="endDate" class="form-control" value="<%= endDate %>">
        </div>

        <div class="form-group">
          <label for="tags" class="form-label">Tags</label>
          <input type="text" id="tags" name="tags" class="form-control" value="<%= tags %>" placeholder="e.g. tech,life (comma-separated)">
        </div>
      </div>

      <div class="checkbox-group" style="margin-bottom: 1rem;">
        <input type="checkbox" id="caseSensitive" name="caseSensitive" value="true" <%= caseSensitive ? 'checked' : '' %>>
        <label for="caseSensitive">Case sensitive</label>
      </div>

      <button type="submit" class="btn btn-primary">Search</button>
      <a href="/search" class="btn btn-outline">Clear</a>
    </form>
  </div>

  <% if (posts.length > 0) { %>
    <div class="post-list">
      <h2 style="margin: 2rem 0 1rem;">Search results (<%= posts.length %>)</h2>
      
      <% posts.forEach(post => { %>
        <div class="post-item">
          <h2 class="post-title">
            <a href="/post/<%= post._id %>"><%= post.title %></a>
          </h2>
          <div class="post-meta">
            <span>👤 <%= post.authorName %></span>
            <span>📅 <%= new Date(post.createdAt).toLocaleDateString('zh-HK', { timeZone: 'Asia/Hong_Kong' }) %></span>
            <span>👁️ <%= post.viewCount %> views</span>
          </div>
          <div class="post-excerpt">
            <%= post.content.substring(0, 200) %><%= post.content.length > 200 ? '...' : '' %>
          </div>
          <% if (post.tags && post.tags.length > 0) { %>
            <div class="post-tags">
              <% post.tags.forEach(tag => { %>
                <a href="/tag/<%= tag %>" class="tag">#<%= tag %></a>
              <% }) %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } else if (searchQuery || startDate || endDate || tags) { %>
    <div class="card" style="margin-top: 2rem;">
      <div class="card-body text-center">
        <p>No posts matched your filters.</p>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
